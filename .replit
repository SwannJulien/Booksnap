modules = ["java-graalvm22.3", "bash", "postgresql-16", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["jdk17"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Booksnap"

[[workflows.workflow]]
name = "Booksnap"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
