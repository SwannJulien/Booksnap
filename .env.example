# ==============================================
# BOOKSNAP - Configuration Template
# ==============================================
# Copy this file to .env and fill in the values
# > cp .env.example .env
# ==============================================

# ----------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------
DB_PORT=5432
POSTGRES_USER=booksnap
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=booksnap_db

# ----------------------------------------------
# PGADMIN (Database Management Interface)
# ----------------------------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@booksnap.com
PGADMIN_DEFAULT_PASSWORD=changeme_admin_password

# ----------------------------------------------
# BACKEND (Spring Boot)
# ----------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# Database host
# - Local (outside Docker): localhost
# - Docker Compose: db (service name)
DB_HOST=db

# Session cookie Secure flag
# - Local dev over plain HTTP: false (a Secure cookie would never be stored)
# - Anywhere served over HTTPS: true
SESSION_COOKIE_SECURE=false

# Browser origins allowed to call the API, comma-separated
# - `npm run dev`: leave empty. The Vite proxy makes the front end same-origin
#   with the API, so no origin has to be declared.
# - `docker compose up`: http://localhost:3000 (front on :3000, API on :8080)
# - Production behind a single domain: empty
# Never `*`: credentials are allowed, and the two are mutually exclusive.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----------------------------------------------
# FIRST ADMINISTRATOR (bootstrap)
# ----------------------------------------------
# NOTE: the backend started from the IDE reads `server/.env`, not this file's copy —
# spring-dotenv loads the `.env` of the working directory. The root `.env` is what
# `docker compose` substitutes. Set these where the backend you actually run will
# read them, and leave the other copy empty rather than duplicating the password.
#
# Used only while NO account holds the `admin` role. Once one exists, these are
# ignored on every start — including the password, which is never re-applied.
#
# Leave them empty unless you are opening a fresh installation. Fill them in, start
# the backend, sign in, change the password from the application, then EMPTY THEM
# AGAIN: this is a password sitting in a file on disk.
#
# The password must be at least 12 characters — a shorter one stops the backend
# instead of creating a weak administrator. Never commit a real value here.
BOOKSNAP_BOOTSTRAP_ADMIN_EMAIL=
BOOKSNAP_BOOTSTRAP_ADMIN_PASSWORD=
BOOKSNAP_BOOTSTRAP_ADMIN_FIRST_NAME=
BOOKSNAP_BOOTSTRAP_ADMIN_LAST_NAME=

# ----------------------------------------------
# FRONTEND (Lit + Vite)
# ----------------------------------------------
FRONTEND_PORT=3000

# Backend API URL — prefix put in front of every /api/... call
# - `npm run dev`: LEAVE EMPTY. Calls then go to the Vite dev server itself, which
#   proxies /api to :8080 (see vite.config.js). Everything is same-origin: no CORS,
#   no SameSite question, and the port Vite actually picked stops mattering.
#   Filling this in with http://localhost:8080 puts the cross-origin problems back.
# - Docker: http://localhost:8080 (the nginx image serves static files only)
# - Production: empty if a reverse proxy serves both, otherwise https://api.example.com
VITE_API_BASE_URL=
