meta {
  name: updateCopy
  type: http
  seq: 5
}

put {
  url: {{vipa}}/api/v1/copies/:copyId
  body: json
  auth: inherit
}

params:path {
  copyId: 1
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
  Content-Type: application/json
}

body:json {
  {
    "libraryId": null,
    "status": "lost",
    "sectionName": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
