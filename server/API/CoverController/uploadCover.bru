meta {
  name: uploadCover
  type: http
  seq: 1
}

post {
  url: {{vipa}}/api/v1/covers?isbn=0987654321
  body: file
  auth: inherit
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

params:query {
  isbn: 0987654321
}

body:file {
  file: @file(/Users/swjulien/Desktop/0987654321.jpg) @contentType(image/jpeg)
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Stores the request body as the cover for the given ISBN, in the `cover` table.
  Re-posting the same ISBN replaces the stored image.

  Returns 400 if the body is empty, larger than `booksnap.cover.max-size-bytes`
  (2 MB by default), or sent with a non-image Content-Type.
}
