meta {
  name: logout
  type: http
  seq: 4
}

post {
  url: {{vipa}}/api/v1/auth/logout
  body: none
  auth: inherit
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Answers 204, invalidates the session server-side and clears the JSESSIONID cookie.

  Handled by Spring Security's LogoutFilter, not by AuthController: the filter catches
  the URL before the dispatcher, so there is no controller method behind this one.

  It is a POST, so it needs a CSRF token like any other write — run `csrf` first.
  Logging out also clears the XSRF-TOKEN cookie, so {{csrfToken}} is stale afterwards:
  re-run `csrf` before the next write.
}
